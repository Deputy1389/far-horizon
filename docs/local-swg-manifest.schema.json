{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Far Horizon local SWG asset manifest",
  "type": "object",
  "required": ["schemaVersion", "source", "generatedAt", "decoder", "inventory", "assets"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "source": { "type": "string" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "decoder": {
      "type": "object",
      "required": ["tre"],
      "properties": {
        "tre": { "type": "string" },
        "key": { "type": "string" }
      },
      "additionalProperties": true
    },
    "inventory": {
      "type": "object",
      "required": ["archiveCount", "parsedArchives", "parsedRows", "validRows", "uniquePaths"],
      "properties": {
        "archiveCount": { "type": "integer", "minimum": 0 },
        "parsedArchives": { "type": "integer", "minimum": 0 },
        "parsedRows": { "type": "integer", "minimum": 0 },
        "validRows": { "type": "integer", "minimum": 0 },
        "uniquePaths": { "type": "integer", "minimum": 0 },
        "versions": { "type": "object" },
        "strides": { "type": "object" },
        "compression": { "type": "object" },
        "errors": { "type": "array" }
      },
      "additionalProperties": true
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "archive", "virtualPath", "kind"],
        "properties": {
          "url": { "type": "string" },
          "archive": { "type": "string" },
          "archivePath": { "type": "string" },
          "archiveRank": { "type": "integer", "minimum": 0 },
          "virtualPath": { "type": "string" },
          "kind": { "type": "string" },
          "uncompressedSize": { "type": "integer", "minimum": 0 },
          "compression": { "type": "integer", "minimum": 0 },
          "sourceKind": { "type": "string" },
          "sourcePath": { "type": "string" }
        },
        "additionalProperties": true
      }
    },
    "selections": { "type": "object" },
    "failedRoles": { "type": "object" },
    "meshCandidates": { "type": "array" },
    "characterCandidates": { "type": "array" },
    "characterFailures": { "type": "object" },
    "characters": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["url", "archive", "virtualPath"],
        "properties": {
          "url": { "type": "string" },
          "bin": { "type": "string" },
          "archive": { "type": "string" },
          "archivePath": { "type": "string" },
          "archiveRank": { "type": "integer", "minimum": 0 },
          "virtualPath": { "type": "string" },
          "shaderBindings": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "textures": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": ["url", "archive", "virtualPath", "kind"],
              "properties": {
                "url": { "type": "string" },
                "archive": { "type": "string" },
                "archivePath": { "type": "string" },
                "archiveRank": { "type": "integer", "minimum": 0 },
                "virtualPath": { "type": "string" },
                "kind": { "type": "string" },
                "uncompressedSize": { "type": "integer", "minimum": 0 },
                "sourceKind": { "type": "string" },
                "sourcePath": { "type": "string" }
              },
              "additionalProperties": true
            }
          },
          "failedTextures": { "type": "object" },
          "sourceSubmeshes": { "type": "integer", "minimum": 0 },
          "hiddenSubmeshes": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          },
          "groundOffset": { "type": "number" },
          "submeshes": { "type": "integer", "minimum": 0 },
          "vertices": { "type": "integer", "minimum": 0 },
          "indices": { "type": "integer", "minimum": 0 },
          "rigged": { "type": "boolean" },
          "bones": { "type": "integer", "minimum": 0 },
          "skins": { "type": "integer", "minimum": 0 },
          "animations": { "type": "integer", "minimum": 0 },
          "skeleton": { "type": "string" },
          "animationPaths": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      }
    },
    "meshProof": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["url", "archive", "virtualPath"],
          "properties": {
            "url": { "type": "string" },
            "bin": { "type": "string" },
            "archive": { "type": "string" },
            "archivePath": { "type": "string" },
            "archiveRank": { "type": "integer", "minimum": 0 },
            "virtualPath": { "type": "string" },
            "submeshes": { "type": "integer", "minimum": 0 },
            "vertices": { "type": "integer", "minimum": 0 },
            "indices": { "type": "integer", "minimum": 0 }
          },
          "additionalProperties": true
        }
      ]
    }
  },
  "additionalProperties": true
}
